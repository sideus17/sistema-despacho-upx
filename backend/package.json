{
  "name": "samu-backend",
  "version": "1.0.0",
  "description": "Backend for SAMU Intelligent Dispatch System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "demo:gerar": "tsx scripts/demo-history.ts gerar",
    "demo:apagar": "tsx scripts/demo-history.ts apagar",
    "db:start": "npx -y supabase@2.119.0 start",
    "db:stop": "npx -y supabase@2.119.0 stop",
    "db:reset": "npx -y supabase@2.119.0 db reset",
    "db:status": "npx -y supabase@2.119.0 status"
  },
  "keywords": [
    "samu",
    "ambulance",
    "dispatch",
    "emergency"
  ],
  "author": "Team SAMU",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
