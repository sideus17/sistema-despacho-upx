# Copie para .env e preencha. Nunca suba o .env para o git.

# Supabase: valores do banco local (npm run db:start). As duas chaves saem de
# `npm run db:status -- -o env` (ANON_KEY e SERVICE_ROLE_KEY). A produção (Render) usa as do projeto hospedado.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=cole-aqui-a-anon-key-do-supabase-status
# Chave secreta: só no backend
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key-do-supabase-status

PORT=3001
# Código que o operador informa no cadastro
OPERATOR_INVITE_CODE=

# Rotas: Valhalla (desvia de áreas). Padrão: servidor público da FOSSGIS, gratuito e não comercial.
# Em produção comercial, apontar para um Valhalla próprio (licença MIT).
VALHALLA_URL=https://valhalla1.openstreetmap.de
VALHALLA_CLIENT_ID=samu-despacho-academico
# Soma máxima dos perímetros das áreas evitadas por consulta, em metros (servidor público: 10 km)
VALHALLA_MAX_EXCLUDE_PERIMETER=9500
# Reserva sem desvio de áreas quando o Valhalla não responde
OSRM_URL=https://router.project-osrm.org

# Fontes oficiais, lidas quando o sistema está em uso (false desliga)
OFFICIAL_SOURCES_ENABLED=true
# CEMADEN (PED, cadastro gratuito em ped.cemaden.gov.br): chuva das estações de Sorocaba
CEMADEN_EMAIL=
CEMADEN_PASSWORD=
# Chuva que, perto de um setor de inundação do SGB, vira "alagamento provável"
CEMADEN_RAIN_1H_MM=30
CEMADEN_RAIN_3H_MM=50
CEMADEN_STATION_DISTANCE_M=6000
# Feed CAP da Defesa Civil (IDAP/MIDR)
DEFESA_CIVIL_CAP_URL=https://idapfile.mdr.gov.br/idap/api/rss/cap
# TomTom (trânsito: incidentes, camada do mapa e tempo de rota); conta gratuita em developer.tomtom.com
TOMTOM_API_KEY=
# Tetos diários (o plano gratuito tem ~2.500 consultas e ~50.000 blocos por dia)
TOMTOM_DAILY_LIMIT=2000
TOMTOM_TILE_DAILY_LIMIT=45000

# Aviso do despacho no celular da equipe (Web Push). Sem as três, o push fica desligado.
# Gerar o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://sistema-despacho-upx.vercel.app
