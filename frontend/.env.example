# Copie para .env.local. Valores do banco local (npm run db:start no backend).
# A produção (Vercel) usa a URL e a anon key do projeto hospedado.

# API do backend pelo proxy do Vite (npm run dev no backend)
VITE_API_URL=/api

# Supabase local pelo proxy do Vite: funciona no computador e no celular (ngrok)
VITE_SUPABASE_URL=/supabase
# A anon key sai de `npm run db:status -- -o env` no backend (ANON_KEY)
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key-do-supabase-status
